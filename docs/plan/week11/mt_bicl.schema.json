{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utility-icl:v3:schemas",
  "oneOf": [
    {
      "$ref": "#/$defs/fact_packet"
    },
    {
      "$ref": "#/$defs/reply"
    },
    {
      "$ref": "#/$defs/utility"
    },
    {
      "$ref": "#/$defs/policy"
    }
  ],
  "$defs": {
    "fact_packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "utility_icl_facts_v3"
        },
        "point_id": {
          "type": "string",
          "pattern": "^(FPT|MWG|VCB|VNM)-20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "frame_end_date": {
          "type": "string",
          "format": "date"
        },
        "prefix_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 45
        },
        "numeric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "macd": {
              "type": [
                "number",
                "null"
              ]
            },
            "signal": {
              "type": [
                "number",
                "null"
              ]
            },
            "macd_minus_signal": {
              "type": [
                "number",
                "null"
              ]
            },
            "close": {
              "type": [
                "number",
                "null"
              ]
            },
            "sma20": {
              "type": [
                "number",
                "null"
              ]
            },
            "close_minus_sma20": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "macd",
            "signal",
            "macd_minus_signal",
            "close",
            "sma20",
            "close_minus_sma20"
          ]
        },
        "bucket": {
          "enum": [
            "MACD_POS_PRICE_POS",
            "MACD_POS_PRICE_NEG",
            "MACD_NEG_PRICE_POS",
            "MACD_NEG_PRICE_NEG",
            "UNKNOWN"
          ]
        },
        "assertions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "MACD_SIGNAL": {
              "enum": [
                "ABOVE",
                "BELOW",
                "EQUAL",
                "UNKNOWN"
              ]
            },
            "MACD_ZERO": {
              "enum": [
                "POSITIVE",
                "NEGATIVE",
                "ZERO",
                "UNKNOWN"
              ]
            },
            "PRICE_SMA20": {
              "enum": [
                "ABOVE",
                "BELOW",
                "EQUAL",
                "UNKNOWN"
              ]
            }
          },
          "required": [
            "MACD_SIGNAL",
            "MACD_ZERO",
            "PRICE_SMA20"
          ]
        },
        "horizon": {
          "const": "T+2.5"
        },
        "reported_warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "source_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "required": [
        "version",
        "point_id",
        "as_of_date",
        "frame_end_date",
        "prefix_rows",
        "numeric",
        "bucket",
        "assertions",
        "horizon",
        "reported_warnings",
        "source_sha256"
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "utility_icl_reply_v3"
        },
        "decision": {
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "forecast_horizon": {
          "const": "T+2.5"
        },
        "confidence": {
          "enum": [
            "Cao",
            "Trung bình",
            "Thấp"
          ]
        },
        "risk_reward_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "evidence_for": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "evidence_against": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "MACD_SIGNAL",
              "MACD_ZERO",
              "PRICE_SMA20"
            ]
          }
        },
        "fact_assertions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "MACD_SIGNAL": {
              "enum": [
                "ABOVE",
                "BELOW",
                "EQUAL",
                "UNKNOWN"
              ]
            },
            "MACD_ZERO": {
              "enum": [
                "POSITIVE",
                "NEGATIVE",
                "ZERO",
                "UNKNOWN"
              ]
            },
            "PRICE_SMA20": {
              "enum": [
                "ABOVE",
                "BELOW",
                "EQUAL",
                "UNKNOWN"
              ]
            }
          },
          "required": [
            "MACD_SIGNAL",
            "MACD_ZERO",
            "PRICE_SMA20"
          ]
        },
        "context_reason": {
          "enum": [
            "NOT_APPLICABLE",
            "SUPPORTED",
            "UTILITY_UNSUPPORTED",
            "QUERY_FEATURE_UNAVAILABLE",
            "UNKNOWN_BUCKET",
            "TARGET_COLD_START"
          ]
        }
      },
      "required": [
        "version",
        "decision",
        "forecast_horizon",
        "confidence",
        "risk_reward_ratio",
        "evidence_for",
        "evidence_against",
        "justification",
        "fact_ids",
        "fact_assertions",
        "context_reason"
      ]
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "utility_icl_posterior_v3"
        },
        "point_id": {
          "type": "string",
          "pattern": "^(FPT|MWG|VCB|VNM)-20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "branch_id": {
          "enum": [
            "MT_BICL",
            "No_target",
            "Stats_only",
            "Utility_only"
          ]
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "UTILITY_UNSUPPORTED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "const": "TEACHER_SIGN_BAYESIAN_BOOTSTRAP_MAGNITUDE"
        },
        "probability_student": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "posterior_mean_theta": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mean_U_net_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "MC_mean_U_net_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "q10_U_net_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "q90_U_net_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "gain_count": {
          "type": "integer",
          "minimum": 0
        },
        "loss_count": {
          "type": "integer",
          "minimum": 0
        },
        "K": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "m": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "draws": {
          "enum": [
            0,
            4096
          ]
        },
        "seed_uint128_decimal": {
          "type": "string",
          "pattern": "^[0-9]{1,39}$"
        },
        "membership_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "draws_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "point_id",
        "branch_id",
        "status",
        "reason",
        "source",
        "probability_student",
        "posterior_mean_theta",
        "mean_U_net_fraction",
        "MC_mean_U_net_fraction",
        "q10_U_net_fraction",
        "q90_U_net_fraction",
        "gain_count",
        "loss_count",
        "K",
        "m",
        "draws",
        "seed_uint128_decimal",
        "membership_sha256",
        "draws_sha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "draws": {
                "const": 4096
              },
              "K": {
                "minimum": 2
              },
              "gain_count": {
                "minimum": 5
              },
              "loss_count": {
                "minimum": 5
              },
              "probability_student": {
                "type": "number"
              },
              "posterior_mean_theta": {
                "type": "number"
              },
              "mean_U_net_fraction": {
                "type": "number"
              },
              "MC_mean_U_net_fraction": {
                "type": "number"
              },
              "q10_U_net_fraction": {
                "type": "number"
              },
              "q90_U_net_fraction": {
                "type": "number"
              },
              "draws_sha256": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "draws": {
                "const": 0
              },
              "draws_sha256": {
                "type": "null"
              },
              "posterior_mean_theta": {
                "type": "null"
              },
              "mean_U_net_fraction": {
                "type": "null"
              },
              "MC_mean_U_net_fraction": {
                "type": "null"
              },
              "q10_U_net_fraction": {
                "type": "null"
              },
              "q90_U_net_fraction": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "utility_icl_policy_v3"
        },
        "point_id": {
          "type": "string",
          "pattern": "^(FPT|MWG|VCB|VNM)-20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "branch_id": {
          "enum": [
            "Fact_Anchor",
            "Plain_revision",
            "MT_BICL",
            "No_utility",
            "No_target",
            "Stats_only",
            "Utility_only"
          ]
        },
        "raw_proposed_action": {
          "enum": [
            "LONG",
            "SHORT",
            "CASH",
            null
          ]
        },
        "anchor_action": {
          "enum": [
            "LONG",
            "CASH"
          ]
        },
        "final_action": {
          "enum": [
            "LONG",
            "CASH"
          ]
        },
        "fact_assertions_valid": {
          "type": "boolean"
        },
        "eligible": {
          "type": "boolean"
        },
        "anchor_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "enum": [
            "KEEP_PROPOSED_SAME",
            "ACCEPT_POSITIVE_Q10_DELTA_U",
            "REJECT_NONPOSITIVE_Q10_DELTA_U",
            "REJECT_FACT_ASSERTIONS",
            "BYPASS_QUERY_FEATURE_UNAVAILABLE",
            "BYPASS_UNKNOWN_BUCKET",
            "BYPASS_UTILITY_UNSUPPORTED",
            "ANCHOR_INVALID_USE_ORIGINAL",
            "NO_NUMERIC_VETO",
            "UTILITY_ONLY_RULE"
          ]
        },
        "q10_delta_U_net_fraction": {
          "type": [
            "number",
            "null"
          ]
        },
        "bypass": {
          "type": "boolean"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "point_id",
        "branch_id",
        "raw_proposed_action",
        "anchor_action",
        "final_action",
        "fact_assertions_valid",
        "eligible",
        "anchor_source_sha256",
        "reason",
        "q10_delta_U_net_fraction",
        "bypass",
        "request_id"
      ]
    }
  }
}
