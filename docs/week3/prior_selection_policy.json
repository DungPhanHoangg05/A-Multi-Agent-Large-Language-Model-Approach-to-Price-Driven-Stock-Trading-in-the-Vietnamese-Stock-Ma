{
  "sampling_version": "prior_sampling_v1",
  "metric_version": "signal_match_v1",
  "default_scope": "same_symbol",
  "default_k": 3,
  "default_seed": 42,
  "normalization": "unicode_NFC_strip_upper_exact_alias",
  "technical_aliases": {
    "BULLISH": ["BULLISH", "BULL", "UP", "TĂNG", "TĂNG GIÁ"],
    "BEARISH": ["BEARISH", "BEAR", "DOWN", "GIẢM", "GIẢM GIÁ"],
    "NEUTRAL": ["NEUTRAL", "TRUNG TÍNH", "TRUNG_TÍNH"]
  },
  "sentiment_aliases": {
    "POSITIVE": ["POSITIVE", "TÍCH CỰC"],
    "NEGATIVE": ["NEGATIVE", "TIÊU CỰC"],
    "NEUTRAL": ["NEUTRAL", "TRUNG TÍNH", "TRUNG_TÍNH"]
  },
  "similarity_weights": {
    "trend": 0.25,
    "pattern": 0.25,
    "alpha_consensus": 0.25,
    "indicator_consensus": 0.25,
    "sentiment": 0.0
  },
  "recent_order": ["exit_date_desc", "episode_id_asc"],
  "similarity_order": ["score_desc", "exit_date_desc", "episode_id_asc"],
  "bayesian_candidates": "eligible_same_regime",
  "random_pool_order": "episode_id_asc",
  "random_seed_fields": ["sampling_version", "seed", "symbol", "as_of_date", "scope"],
  "random_seed_encoding": "json_sort_keys_ensure_ascii_false_separators_comma_colon_UTF8_SHA256_big_endian_integer",
  "random_algorithm": "python_3_13_random_Random_sample",
  "random_result_order": "sample_draw_order",
  "insufficient_policy": "use_available_without_scope_or_regime_expansion"
}
